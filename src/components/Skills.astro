---
const langs = [
  "TypeScript",
  "JavaScript",
  "HTML",
  "C",
  "Java",
  "Python",
];

const frameworks = [
  "Angular",
  "Astro",
  "Node.js",
  ".NET / Blazor",
  "Tailwind",
];

const databases = [
  "PostgreSQL",
  "MongoDB",
];

const tools = [
  "Git",
  "VS Code",
  "Postman",
  "Figma",
];
---

<style>
  /* Los bloques que “caen” y se desenfocan al alejarse del punto dulce */
  .reveal-block {
    will-change: transform, opacity, filter;
  }
</style>

<section id="skills" class="space-y-8 border-t border-zinc-900 pt-14 mt-8">
  <h2 class="text-xl font-semibold tracking-tight text-zinc-100">Competencias</h2>

  <!-- 1) Desarrollo (Full-stack) -->
  <div class="space-y-4 reveal-block" data-reveal-block>
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">Desarrollo (Full-stack)</h3>
    <p class="text-[0.95rem] text-zinc-300 leading-relaxed">
      Enfoque principal en frontend moderno (accesibilidad, rendimiento y DX), con experiencia en backend y
      APIs REST. Nivel actual global: <span class="text-zinc-100">básico–medio</span>.
    </p>

    <!-- Lenguajes -->
    <div class="space-y-2">
      <p class="text-[0.8rem] text-zinc-400">Lenguajes</p>
      <div class="flex flex-wrap gap-2">
        {langs.map((t) => (
          <span
            data-magnet
            class="px-2.5 py-1 rounded-full bg-zinc-900/70 border border-zinc-800 text-zinc-200 text-xs"
          >
            {t}
          </span>
        ))}
      </div>
    </div>

    <!-- Frameworks / Librerías / Plataformas -->
    <div class="space-y-2">
      <p class="text-[0.8rem] text-zinc-400">Frameworks & Librerías</p>
      <div class="flex flex-wrap gap-2">
        {frameworks.map((t) => (
          <span
            data-magnet
            class="px-2.5 py-1 rounded-full bg-zinc-900/70 border border-zinc-800 text-zinc-200 text-xs"
          >
            {t}
          </span>
        ))}
      </div>
    </div>

    <!-- Bases de datos -->
    <div class="space-y-2">
      <p class="text-[0.8rem] text-zinc-400">Bases de datos</p>
      <div class="flex flex-wrap gap-2">
        {databases.map((t) => (
          <span
            data-magnet
            class="px-2.5 py-1 rounded-full bg-zinc-900/70 border border-zinc-800 text-zinc-200 text-xs"
          >
            {t}
          </span>
        ))}
      </div>
    </div>

    <!-- Herramientas -->
    <div class="space-y-2">
      <p class="text-[0.8rem] text-zinc-400">Herramientas</p>
      <div class="flex flex-wrap gap-2">
        {tools.map((t) => (
          <span
            data-magnet
            class="px-2.5 py-1 rounded-full bg-zinc-900/70 border border-zinc-800 text-zinc-200 text-xs"
          >
            {t}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- separador sutil -->
  <div class="h-px bg-zinc-900"></div>

  <!-- 2) Formación -->
  <div class="space-y-4 reveal-block" data-reveal-block>
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">Formación</h3>
    <ul class="space-y-3 text-zinc-300 leading-relaxed">
      <li>
        <span class="font-medium text-zinc-100">Grado en Ingeniería Informática (4º curso)</span>.
        Especialización en <span class="text-zinc-100">Ingeniería del Software</span> · En curso.
      </li>
      <li>
        <span class="font-medium text-zinc-100">Enseñanzas Profesionales de Piano</span> · Finalizadas.
      </li>
      <li>
        <span class="font-medium text-zinc-100">Producción musical</span> · Autodidacta (+4 años).
      </li>
    </ul>
  </div>

  <!-- 3) Música & Sonido (resumen) -->
  <div class="space-y-4 reveal-block" data-reveal-block>
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">Música & Sonido</h3>
    <ul class="space-y-2 text-zinc-300 leading-relaxed">
      <li>Mix y master finales · Mezcla de voces.</li>
      <li>Creación de <span class="text-zinc-100">loops</span>, <span class="text-zinc-100">samples</span> e <span class="text-zinc-100">instrumentales</span> completas.</li>
      <li>Compresión (batería, paralela, multibanda) y ecualización dinámica/multibanda.</li>
      <li>Síntesis granular y <span class="text-zinc-100">sound design</span> (Serum, Vital).</li>
      <li>Distorsión, clipping, saturación y gestión del campo estéreo.</li>
    </ul>
  </div>

  <!-- 4) Idiomas & Certificados -->
  <div class="space-y-4 reveal-block" data-reveal-block>
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">Idiomas & Certificados</h3>
    <ul class="space-y-2 text-zinc-300 leading-relaxed">
      <li>Inglés <span class="text-zinc-100 font-medium">B2</span> (MCER).</li>
      <li>Permiso de conducción <span class="text-zinc-100 font-medium">B</span>.</li>
    </ul>
  </div>

  <!-- Chips magnéticos + scroll animado (A ↔ B) -->
  <script>
    import { initMagnet } from "../lib/anim";

    if (typeof window !== "undefined") {
      let destroyMagnet: null | (() => void) = null;

      const selectBlocks = () =>
        Array.from(document.querySelectorAll<HTMLElement>("[data-reveal-block]"));

      const updateBlocks = () => {
        const blocks = selectBlocks();
        if (!blocks.length) return;

        const vh = window.innerHeight || 1;

        // Punto A y B en la pantalla:
        // A = cuando la parte superior del bloque está al 80% de la altura de la ventana
        // B = cuando esa parte superior está al 60%
        const start = vh * 0.9;
        const end = vh * 0.78;
        const range = start - end || 1;

        blocks.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const top = rect.top;

          // t = 0 → punto A (más difuminado, más arriba)
          // t = 1 → punto B (nítido, en su sitio)
          const raw = (start - top) / range;
          const t = Math.max(0, Math.min(1, raw));

          const blur = (1 - t) * 4;        // 4px → 0px
          const translateY = (1 - t) * -10; // -10px → 0px (cae un poco)
          const opacity = 0.2 + 0.8 * t;   // 0.2 → 1

          el.style.opacity = String(opacity);
          el.style.transform = `translateY(${translateY}px)`;
          el.style.filter = `blur(${blur}px)`;
        });
      };

      const onReady = () => {
        destroyMagnet = initMagnet("[data-magnet]", 120);
        updateBlocks();
        window.addEventListener("scroll", updateBlocks);
        window.addEventListener("resize", updateBlocks);
      };

      const onPageHide = () => {
        destroyMagnet?.();
        destroyMagnet = null;
        window.removeEventListener("scroll", updateBlocks);
        window.removeEventListener("resize", updateBlocks);
      };

      window.addEventListener("DOMContentLoaded", onReady, { once: true });
      window.addEventListener("pagehide", onPageHide);
    }
  </script>
</section>
