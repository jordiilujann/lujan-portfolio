---
import AudioPlayer from "./AudioPlayer.astro";

const instrumentals = [
  {
    title: "Life Letters DnB version - 160bpm / Bb m",
    mood: "dnb / sampled",
    dry: "/audio/instrumentales/drum-and-bass-raw.mp3",
    master: "/audio/instrumentales/drum-and-bass-master.mp3",
    description:
      "En esta instrumental sampleé las vocales de una canción. El resto de instrumentos son de plugins como Analog Lab V (synths), Keyzone Classic (piano). Para las texturas y efectos utilicé plugins de síntesis granular como autochroma, finisher-fluxx o efx-motions. En cuanto al master utilicé compresión multibanda, ecualización aditiva, el soothe2 para suprimir algunas resonancias, un soft clipper para ganar potencia y no sobrepasar los 0db y por último un limiter a -0,1db.",
  },
  {
    title: "Satélite - 150bpm / Am",
    mood: "electrónico / trap",
    dry: "/audio/instrumentales/electronica-raw.mp3",
    master: "/audio/instrumentales/electronica-master.mp3",
    description:
      "Esta instrumental fue un pedido de un cantante de Madrid con el que he colaborado alguna vez. Me pidió una instrumental inspirada en la canción MayDay - TheFatRat. Para hacer la canción utilicé muchos sonidos de Serum (synth). También para las strings utilicé las de BBC Symphony Orchestra y en cuanto a los drums utilicé una librería que encontré por reddit. Esta puede que sea una de las instrumentales con sonido más profesional que tengo ya que le he dedicado mucho tiempo tanto a la composición, como al procesado de sonidos, como al mix y al master.",
  },
  {
    title: "Kyoto - 94bpm / Fm",
    mood: "reggaeton / trap",
    dry: "/audio/instrumentales/reggaeton-con-beatswitch-raw.mp3",
    master: "/audio/instrumentales/reggaeton-con-beatswitch-master.mp3",
    description:
      "El reggaetón oscuro con texturas espaciales es mi punto fuerte en beatmaking y creo que con este beat queda demostrado. Un beat del cual estoy muy contento y combino muchas técnicas de procesado de sonido, tanto con síntesis granular como con distorsión o saturación. En cuanto al master también quedé muy contento ya que ha quedado un resultado muy profesional y las frecuencias agudas fueron un reto porque me generaban muchas resonancias pero finalmente lo pude solventar.",
  },
  {
    title: "Trap Travis",
    mood: "trap / oscuro",
    dry: "/audio/instrumentales/trap-travis-raw.mp3",
    master: "/audio/instrumentales/trap-travis-master.mp3",
    description:
      "Inspirada en el universo de Travis Scott: 808 profundos, texturas espaciales y una atmósfera cinematográfica con carácter.",
  },
  // placeholders (ajusta rutas cuando subas los audios)
  {
    title: "Chrome Dreams",
    mood: "hyperpop / experimental",
    dry: "/audio/instrumentales/chrome-dreams_dry.mp3",
    master: "/audio/instrumentales/chrome-dreams_master.mp3",
    description:
      "Estética hyperpop con capas brillantes y distorsión armónica. Búsqueda de tensión entre lo digital y lo emocional.",
  },
  {
    title: "Sunset Lines",
    mood: "chill / lofi",
    dry: "/audio/instrumentales/sunset-lines_dry.mp3",
    master: "/audio/instrumentales/sunset-lines_master.mp3",
    description:
      "Tonos cálidos, percusiones suaves y un ambiente nostálgico de atardecer. Ideal para momentos introspectivos.",
  },
];

const abTests = [
  {
    id: "mix1",
    title: "Mix & Master — Example 1",
    dry: "/audio/mixmaster/example1_dry.mp3",
    master: "/audio/mixmaster/example1_master.mp3",
  },
  {
    id: "mix2",
    title: "Mix & Master — Example 2",
    dry: "/audio/mixmaster/example2_dry.mp3",
    master: "/audio/mixmaster/example2_master.mp3",
  },
];
---

<section id="music" class="space-y-10 border-t border-zinc-900 pt-14 mt-8">
  <h2 class="text-xl font-semibold tracking-tight text-zinc-100">
    Música · Instrumentales & Mix/Master
  </h2>

  <!-- Instrumentales -->
  <div class="space-y-4">
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">
      Instrumentales seleccionadas
    </h3>

    <div class="grid md:grid-cols-3 gap-5">
      {instrumentals.map((track) => (
        <AudioPlayer
          title={track.title}
          mood={track.mood}
          dry={track.dry}
          master={track.master}
          description={track.description}
        />
      ))}
    </div>
  </div>

  <!-- Mix & Master A/B -->
  <div class="space-y-4">
    <h3 class="text-sm font-semibold text-zinc-300 uppercase tracking-wide">
      Ejemplos de Mix & Master (A/B)
    </h3>
    <p class="text-[0.8rem] text-zinc-400 max-w-2xl">
      Pulsa la palanca para alternar entre la mezcla original y la versión masterizada.
      La comparación es instantánea para apreciar la diferencia real.
    </p>

    <div class="grid md:grid-cols-2 gap-5">
      {abTests.map((item) => (
        <div
          class="p-4 rounded-2xl bg-zinc-900/90 border border-zinc-800 space-y-3"
          data-ab-root={item.id}
        >
          <p class="text-sm font-medium text-zinc-100">
            {item.title}
          </p>

          <div class="flex items-center justify-between gap-3">
            <span class="text-[0.7rem] text-zinc-500">Original</span>
            <button
              type="button"
              class="relative w-14 h-7 rounded-full bg-zinc-800 border border-zinc-700 flex items-center transition-all"
              data-role="toggle"
              data-state="off"
            >
              <span
                class="block w-5 h-5 bg-zinc-300 rounded-full translate-x-1 transition-all"
                data-role="knob"
              ></span>
            </button>
            <span class="text-[0.7rem] text-zinc-500">Master</span>
          </div>

          <div class="text-[0.7rem] text-zinc-500">
            <span data-role="label">Reproduciendo: Original</span>
          </div>

          <audio src={item.dry} class="hidden" data-audio="dry"></audio>
          <audio src={item.master} class="hidden" data-audio="master"></audio>
        </div>
      ))}
    </div>
  </div>

  <script>
    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", () => {
        const abBlocks = document.querySelectorAll<HTMLElement>("[data-ab-root]");

        abBlocks.forEach((block) => {
          const toggle = block.querySelector<HTMLButtonElement>("[data-role='toggle']");
          const knob = block.querySelector<HTMLSpanElement>("[data-role='knob']");
          const label = block.querySelector<HTMLSpanElement>("[data-role='label']");
          const dry = block.querySelector<HTMLAudioElement>("[data-audio='dry']");
          const master = block.querySelector<HTMLAudioElement>("[data-audio='master']");

          if (!toggle || !knob || !label || !dry || !master) return;

          label.textContent = "Reproduciendo: Original";

          toggle.addEventListener("click", () => {
            const isOn = toggle.dataset.state === "on";

            // detener ambos antes de cambiar (estos ejemplos A/B simples)
            dry.pause();
            master.pause();
            dry.currentTime = 0;
            master.currentTime = 0;

            if (!isOn) {
              toggle.dataset.state = "on";
              toggle.classList.remove("bg-zinc-800");
              toggle.classList.add("bg-emerald-500/80");
              knob.classList.remove("translate-x-1");
              knob.classList.add("translate-x-8");
              label.textContent = "Reproduciendo: Master";
              master.play();
            } else {
              toggle.dataset.state = "off";
              toggle.classList.remove("bg-emerald-500/80");
              toggle.classList.add("bg-zinc-800");
              knob.classList.remove("translate-x-8");
              knob.classList.add("translate-x-1");
              label.textContent = "Reproduciendo: Original";
              dry.play();
            }
          });
        });
      });
    }
  </script>
</section>
