---
const projects = [
  {
    id: "solidarity-hub",
    title: "Solidarity Hub Visualization",
    stack: ["Blazor", ".NET", "PostgreSQL"],
    role: "Frontend · Visualización de datos",
    description:
      "Módulo web para visualizar recursos y afectados en catástrofes. Gráficas, mapas y paneles de control conectados a una API compartida.",
  },
  {
    id: "record",
    title: "Record · Gestión de eventos",
    stack: ["Angular", "Node.js", "REST APIs"],
    role: "Full-stack académico",
    description:
      "Aplicación web para gestión de eventos y reservas. Trabajo de arquitectura, componentes reutilizables y consumo de servicios REST.",
  },
  {
    id: "portfolio",
    title: "Lujan.dev (esta web)",
    stack: ["Astro", "TypeScript", "Tailwind"],
    role: "Diseño, desarrollo y música",
    description:
      "Landing personal centrada en frontend y producción musical. Animaciones suaves, audio players personalizados y diseño dark minimalista.",
  },
];
---

<section id="projects" class="space-y-8 border-t border-zinc-900 pt-14 mt-8">
  <h2 class="text-xl font-semibold tracking-tight text-zinc-100">
    Proyectos
  </h2>

  <p class="text-[0.95rem] text-zinc-300 max-w-2xl leading-relaxed">
    Selección de proyectos donde mezclo desarrollo web, buenas prácticas y, en algunos casos, mi parte más creativa.
  </p>

  <div class="grid gap-5 md:grid-cols-3">
    {projects.map((p) => (
      <article
        class="project-card group relative flex flex-col gap-3 rounded-2xl bg-zinc-900/90 border border-zinc-800 px-4 py-4
               transition-colors duration-200"
        data-project-card
        data-project-id={p.id}
      >
        <header class="space-y-1">
          <h3 class="text-sm font-semibold text-zinc-100 group-hover:text-emerald-300">
            {p.title}
          </h3>
          <p class="text-[0.75rem] text-zinc-400">{p.role}</p>
        </header>

        <p class="text-[0.8rem] text-zinc-300 leading-relaxed flex-1">
          {p.description}
        </p>

        <div class="flex flex-wrap gap-1.5 pt-1">
          {p.stack.map((tag) => (
            <span
              class="rounded-full border border-zinc-800 bg-zinc-900/70 px-2 py-0.5 text-[0.7rem] text-zinc-300
                     group-hover:border-emerald-400/50 group-hover:text-emerald-200"
            >
              {tag}
            </span>
          ))}
        </div>

        <div class="pt-1 text-[0.7rem] text-zinc-500">
          <span class="cursor-default select-none">Detalles próximamente.</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* --- DROP-IN (gravedad al entrar en viewport) --- */

  .project-card {
    opacity: 0;
    transform: translate3d(0, -18px, 0) scale(0.98);
    filter: blur(7px);
    transform-origin: center top;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transition:
      opacity 460ms ease-out,
      transform 620ms cubic-bezier(.16, 1, .3, 1),
      filter 520ms ease-out,
      box-shadow 220ms ease-out,
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }

  .project-card.in-view {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
  }

  /* Estado mientras se arrastra / lanza */
  .project-card.drag-active {
    cursor: grabbing;
    z-index: 30;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card.in-view {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      box-shadow: none !important;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>("[data-project-card]")
      );

      if (!cards.length) return;

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      /* ---------- OBSERVER: gravedad al entrar ---------- */

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              el.classList.add("in-view");
            } else {
              el.classList.remove("in-view");
              if (!el.classList.contains("drag-active")) {
                el.style.transform = "";
                el.style.boxShadow = "";
              }
            }
          });
        },
        { threshold: 0.35 }
      );

      cards.forEach((card) => observer.observe(card));

      /* ---------- HOVER TILT 3D (solo si no se está arrastrando) ---------- */

      cards.forEach((card) => {
        let rect: DOMRect | null = null;

        const handleMove = (ev: MouseEvent) => {
          if (card.classList.contains("drag-active")) return;
          if (!card.classList.contains("in-view")) return;

          if (!rect) rect = card.getBoundingClientRect();

          const x = (ev.clientX - rect.left) / rect.width; // 0..1
          const y = (ev.clientY - rect.top) / rect.height; // 0..1

          const maxTilt = 6;
          const rotateY = (x - 0.5) * -2 * maxTilt;
          const rotateX = (y - 0.5) * 2 * maxTilt;

          card.style.transform = `
            translate3d(0, -4px, 0)
            rotateX(${rotateX.toFixed(2)}deg)
            rotateY(${rotateY.toFixed(2)}deg)
          `;
        };

        const handleEnter = () => {
          if (card.classList.contains("drag-active")) return;
          if (!card.classList.contains("in-view")) return;

          card.style.transition =
            "transform 180ms cubic-bezier(.18,.89,.32,1.28), box-shadow 200ms ease-out";
          card.style.boxShadow = "0 22px 50px rgba(0,0,0,0.7)";
        };

        const handleLeave = () => {
          if (card.classList.contains("drag-active")) return;

          card.style.transition =
            "transform 220ms cubic-bezier(.18,.89,.32,1.1), box-shadow 180ms ease-out";
          card.style.transform = "";
          card.style.boxShadow = "";
          rect = null;
        };

        card.addEventListener("mouseenter", handleEnter);
        card.addEventListener("mousemove", handleMove);
        card.addEventListener("mouseleave", handleLeave);
      });

      /* ---------- PHYSICS MODE (desktop, long-press) ---------- */

      const startThrow = (
        card: HTMLElement,
        startOffset: { x: number; y: number },
        velocity: { x: number; y: number }
      ) => {
        if (prefersReduced) {
          // sin físicas → snap back directo
          card.style.transition =
            "transform 260ms cubic-bezier(.16,1,.3,1), box-shadow 200ms ease-out";
          card.style.transform = "";
          setTimeout(() => {
            card.classList.remove("drag-active");
            card.style.transition = "";
          }, 260);
          return;
        }

        let x = startOffset.x;
        let y = startOffset.y;

        // Escalamos velocidad de “ratón px/ms” a algo jugable
        let vx = velocity.x * 2;
        let vy = velocity.y * 2;

        const gravity = 0.0022; // px/ms^2
        const friction = 0.9;
        const maxDuration = 900; // ms

        let lastTime = performance.now();
        const startTime = lastTime;

        const step = (now: number) => {
          const dt = now - lastTime;
          lastTime = now;

          vx *= friction;
          vy = vy * friction + gravity * dt;

          x += vx * dt;
          y += vy * dt;

          card.style.transform = `translate3d(${x}px, ${y}px, 0)`;

          if (now - startTime < maxDuration) {
            requestAnimationFrame(step);
          } else {
            // Snap back a su sitio original
            card.style.transition =
              "transform 320ms cubic-bezier(.16,1,.3,1), box-shadow 260ms ease-out";
            card.style.transform = "";
            card.style.boxShadow = "";
            setTimeout(() => {
              card.classList.remove("drag-active");
              card.style.transition = "";
              card.style.willChange = "";
            }, 340);
          }
        };

        requestAnimationFrame(step);
      };

      cards.forEach((card) => {
        // Solo desktop y sin reduced motion
        const enabled =
          () =>
            window.innerWidth >= 1024 && !prefersReduced;

        let pressTimer: number | null = null;
        let isDragging = false;
        let startX = 0;
        let startY = 0;
        let currentOffset = { x: 0, y: 0 };
        let lastPos = { x: 0, y: 0, t: 0 };
        let velocity = { x: 0, y: 0 };

        const LONG_PRESS_MS = 220;
        const MOVE_CANCEL_THRESHOLD = 5; // px

        card.addEventListener("pointerdown", (ev) => {
          if (!enabled()) return;
          if (!card.classList.contains("in-view")) return;

          // evitamos conflicto con scroll
          startX = ev.clientX;
          startY = ev.clientY;
          currentOffset = { x: 0, y: 0 };
          velocity = { x: 0, y: 0 };
          lastPos = { x: ev.clientX, y: ev.clientY, t: performance.now() };

          pressTimer = window.setTimeout(() => {
            isDragging = true;
            card.classList.add("drag-active");
            card.style.transition = "none";
            card.style.willChange = "transform";
            card.setPointerCapture(ev.pointerId);
          }, LONG_PRESS_MS);
        });

        card.addEventListener("pointermove", (ev) => {
          if (pressTimer) {
            // si se mueve demasiado antes de que se active el long-press → cancelar
            const dx0 = ev.clientX - startX;
            const dy0 = ev.clientY - startY;
            if (
              Math.abs(dx0) > MOVE_CANCEL_THRESHOLD ||
              Math.abs(dy0) > MOVE_CANCEL_THRESHOLD
            ) {
              clearTimeout(pressTimer);
              pressTimer = null;
            }
          }

          if (!isDragging) return;

          const now = performance.now();
          const dx = ev.clientX - startX;
          const dy = ev.clientY - startY;
          currentOffset = { x: dx, y: dy };

          const dt = now - lastPos.t || 1;
          velocity = {
            x: (ev.clientX - lastPos.x) / dt,
            y: (ev.clientY - lastPos.y) / dt,
          };
          lastPos = { x: ev.clientX, y: ev.clientY, t: now };

          card.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
        });

        const endDrag = (ev: PointerEvent) => {
          if (pressTimer) {
            clearTimeout(pressTimer);
            pressTimer = null;
          }
          if (!isDragging) return;
          isDragging = false;
          try {
            card.releasePointerCapture(ev.pointerId);
          } catch {
            // por si acaso
          }
          startThrow(card, currentOffset, velocity);
        };

        card.addEventListener("pointerup", endDrag);
        card.addEventListener("pointercancel", endDrag);
        card.addEventListener("pointerleave", (ev) => {
          if (isDragging) endDrag(ev as PointerEvent);
        });
      });
    });
  }
</script>
