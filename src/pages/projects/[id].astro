---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectById, projects, type Project } from "../../data/projects";

// Static paths para las rutas dinámicas /projects/[id]
export function getStaticPaths() {
  return projects.map((p) => ({
    params: { id: p.id },
  }));
}

const { id } = Astro.params;
const project = getProjectById(id as string);

if (!project) {
  throw new Error(`Proyecto no encontrado: ${id}`);
}

const pageTitle = `${project.title} · Proyectos - Lujan.dev`;
const pageDescription = project.descriptionLong ?? project.description;

// Por si en algún lado falta algo, que no casque
const tags: string[] = project.tags ?? [];
const tech: string[] = project.tech ?? [];
const images = project.images ?? [];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="max-w-5xl mx-auto py-12 space-y-10 px-4 sm:px-0">
    <!-- Cabecera -->
    <header class="space-y-3">
      <p class="text-xs font-semibold tracking-[0.2em] text-zinc-500 uppercase">
        Proyecto
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50">
        {project.title}
      </h1>
      <p class="text-sm text-zinc-400">
        {project.subtitle}
      </p>
    </header>

    <!-- Grid principal: descripción + ficha lateral -->
    <section class="grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1.15fr)] items-start">
      <!-- Columna izquierda: descripción -->
      <div class="space-y-6">
        <p class="text-[0.95rem] leading-relaxed text-zinc-200 whitespace-pre-line">
          {pageDescription}
        </p>

        <!-- Tags / tecnologías cortas -->
        {tags.length > 0 && (
          <div class="space-y-2">
            <p class="text-[0.8rem] text-zinc-400">Tecnologías destacadas</p>
            <div class="flex flex-wrap gap-2">
              {tags.map((t) => (
                <span class="px-2.5 py-1 rounded-full bg-zinc-900/80 border border-zinc-800 text-[0.7rem] text-zinc-200">
                  {t}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Columna derecha: ficha/resumen -->
      <aside class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-4 space-y-4">
        <h2 class="text-sm font-semibold text-zinc-100">
          Detalles del proyecto
        </h2>

        <dl class="space-y-2 text-[0.8rem] text-zinc-300">
          {project.role && (
            <div class="flex gap-2">
              <dt class="w-20 text-zinc-500">Rol</dt>
              <dd class="flex-1">{project.role}</dd>
            </div>
          )}

          {project.kind && (
            <div class="flex gap-2">
              <dt class="w-20 text-zinc-500">Tipo</dt>
              <dd class="flex-1">{project.kind}</dd>
            </div>
          )}

          {project.year && (
            <div class="flex gap-2">
              <dt class="w-20 text-zinc-500">Año</dt>
              <dd class="flex-1">{project.year}</dd>
            </div>
          )}

          {tech.length > 0 && (
            <div class="flex gap-2">
              <dt class="w-20 text-zinc-500">Stack</dt>
              <dd class="flex-1">
                {tech.join(", ")}
              </dd>
            </div>
          )}
        </dl>

        {(project.repoUrl || project.liveUrl) && (
          <div class="pt-2 space-y-2 text-[0.8rem]">
            {project.repoUrl && (
              <a
                href={project.repoUrl}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300"
              >
                <span>Ver repositorio</span>
                <span>↗</span>
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noreferrer"
                class="block text-zinc-400 hover:text-zinc-200"
              >
                Ver versión en producción
              </a>
            )}
          </div>
        )}
      </aside>
    </section>

    <!-- Capturas (cuando las tengas) -->
    {images.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-sm font-semibold text-zinc-100">Capturas</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {images.map((img) => (
            <figure class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/70">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-300"
              />
              <figcaption class="px-3 py-2 text-[0.75rem] text-zinc-400">
                {img.alt}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
